{
  "name": "bhp-medan-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --mode development",
    "build:production": "vite build --mode production",
    "preview": "vite preview --host 0.0.0.0",
    "native:add:android": "node -r ./scripts/node-windows-userinfo-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor add android",
    "native:add:ios": "node -r ./scripts/node-windows-userinfo-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor add ios",
    "cap:sync": "npm run build && node -r ./scripts/node-windows-userinfo-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor sync",
    "android": "npm run cap:sync && node -r ./scripts/node-windows-userinfo-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor open android",
    "ios": "npm run cap:sync && node -r ./scripts/node-windows-userinfo-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
